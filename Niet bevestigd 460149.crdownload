else if(Math.abs(Math.abs(b.x)-3.66)<.3&&b.y<2.5){v.z*=-.5;v.x*=-.4;tone(1500,.3,'triangle',.2);msg('PAAL!',.8)}}}
// loop
let last=performance.now();
function loop(n){requestAnimationFrame(loop);const dt=Math.min(.033,(n-last)/1e3);last=n;if(run)update(dt);
if(raining){const a=rn.geometry.attributes.position.array;for(let i=0;i<RN;i++){a[i*3+1]-=dt*26;if(a[i*3+1]<0)a[i*3+1]=30}rn.geometry.attributes.position.needsUpdate=true;rn.position.set(cam.position.x,0,cam.position.z-15)}
const fo=celeb>0||!!(cel&&cel.arr);phs.forEach(p=>{p.fl.visible=fo&&R()<.3;p.fl.scale.setScalar(3+R()*4)});flS.forEach(s=>s.visible=false);
