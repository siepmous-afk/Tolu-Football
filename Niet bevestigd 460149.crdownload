// acro
if(P.acro>0){P.acro-=dt;const t=.8-P.acro;if(!P.acroDone&&t>=.3&&t<=.55&&A.state=='live'&&!A.shot){const d=B.p.distanceTo(V(P.x,P.y+1.7,P.z));
if(d<2){P.acroDone=1;P.kick=.3;const[a,i]=acrFor(save.lvl);A.acroT=a;hit(a[1],Math.min(1,1.15-d/2),i==3?1.9:1.1+.12*i);msg(a[1].toUpperCase()+'!',1)}}}
if(cel){cel.t+=dt;if(cel.k=='corner'&&cel.arr&&!cel.sp){cel.sp=1;pile.forEach((o,i)=>{o.x=cel.x+Math.cos(i*1.05)*9;o.z=cel.z+Math.sin(i*1.05)*7+4;o.g.visible=true})}
if(cel.sp)pile.forEach((o,i)=>{const tx=cel.x+Math.cos(i*1.05+.4)*.9,tz=cel.z+Math.sin(i*1.05+.4)*.9,dx=tx-o.x,dz=tz-o.z,dl=Math.hypot(dx,dz);let s=0;if(dl>.15){s=7;o.x+=dx/dl*s*dt;o.z+=dz/dl*s*dt}o.g.position.set(o.x,dl<.3?Math.abs(Math.sin(cel.t*8+i))*.8:0,o.z);o.g.rotation.y=Math.atan2(cel.x-o.x,cel.z-o.z);anim(o,dt,s,false);if(dl<.3){o.armL.rotation.z=-2.6;o.armR.rotation.z=2.6}})}
// swing contact
if(P.sw){const w=P.sw;w.t+=dt;if(!w.done&&A.state=='live'&&!A.shot&&w.t>=w.a&&w.t<=w.b){const hd=w.k=='head',d=B.p.distanceTo(hd?V(P.x,P.y+1.85,P.z-.15):V(P.x,P.y+.5,P.z-.5)),Rr=hd?1.4:1.7;
if(d<Rr){w.done=1;hit(hd?'Kopbal':(P.y>.3?'Volley':'Schot'),Math.min(1,1.15-d/Rr),hd?(save.lvl>=3?.62:.4):(P.y<=.3||save.lvl>=6?1:.6))}}if(w.t>w.b)P.sw=null}
// anim player
anim(me,dt,Math.hypot(P.vx,P.vz),P.y>0);me.wh.forEach(w=>w.rotation.x+=Math.hypot(P.vx,P.vz)*dt/.33);if(cel&&cel.arr&&cel.k=='corner'){me.armL.rotation.z=-2.6;me.armR.rotation.z=2.6}me.g.position.set(P.x,P.y,P.z);me.g.rotation.y=P.f;
me.pv.rotation.x=P.acro>0?-2.5*Math.sin(Math.PI*Math.min(1,(.8-P.acro)/.8)):.5*Math.sin(Math.PI*(1-P.head/.3))*(P.head>0?1:0);
if(P.acro>0){const t=Math.max(0,.8-P.acro),th=-2.5*Math.sin(Math.PI*Math.min(1,t/.8)),s=Math.sin(Math.PI*Math.min(1,t/.8));me.legR.rotation.x=-.7*s;me.legL.rotation.x=.5*s;me.armL.rotation.z=-1.4*s;me.armR.rotation.z=1.4*s;me.pv.position.y=.9+.25*s}else if(P.kick>0)me.legR.rotation.x=-1.7*Math.sin((1-P.kick/.25)*Math.PI*.9);
if(cel&&cel.arr)celAnim(dt);
// crosser
if(cr.kick>0)cr.kick-=dt;anim(cr,dt,0,false);if(A.state=='wait'){cr.legR.rotation.x=-.6*Math.sin(A.t*6)}else if(cr.kick>0)cr.legR.rotation.x=-1.7*Math.sin((1-cr.kick/.3)*Math.PI*.9);
if(A.state=='wait'&&A.t>1)cross();if(A.type=='keep'&&!A.res&&!A.shot){const u=Math.max(0,Math.min(1,(A.t-1.2)/1.2));cr.g.position.z=A.bz-3*u;if(A.t>2.4)oppShot()}
// ball
if(A.dribble&&!A.shot){const sp=Math.hypot(P.vx,P.vz),ux=sp>.5?P.vx/sp:0,uz=sp>.5?P.vz/sp:-1;B.p.set(P.x+ux*.8,.25+Math.abs(Math.sin(A.t*Math.min(sp,9)*1.2))*.18,P.z+uz*.8);B.v.set(P.vx,0,P.vz)}else if(A.state!='wait'){for(let i=0;i<2;i++)bstep(dt/2)}
ball.position.copy(B.p);ball.rotation.x-=B.v.z*dt*4;ball.rotation.z+=B.v.x*dt*4;
// defenders
