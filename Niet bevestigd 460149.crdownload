// update
function update(dt){
A.t+=dt;P.cd-=dt;P.slow-=dt;P.kick=Math.max(0,P.kick-dt);P.head=Math.max(0,P.head-dt);P.touch-=dt;
let ix=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0)+joy.x,iz=(keys.KeyS||keys.ArrowDown?1:0)-(keys.KeyW||keys.ArrowUp?1:0)+joy.y;if(cel){const dx=cel.x-P.x,dz=cel.z-P.z,dl=Math.hypot(dx,dz);if(dl>.9){ix=dx/dl;iz=dz/dl}else{ix=iz=0;cel.arr=1}}if(A.type=='keep'){ix=iz=0}const m=Math.hypot(ix,iz);if(m>1){ix/=m;iz/=m}
const sp=ST.speed*((keys.ShiftLeft||keys.ShiftRight||sprintBtn)?1.45:1)*(P.slow>0?.5:1),k=Math.min(1,dt*(P.y>0?3:9));
P.vx+=(ix*sp-P.vx)*k;P.vz+=(iz*sp-P.vz)*k;P.x=Math.max(-33,Math.min(33,P.x+P.vx*dt));P.z=Math.max(-50,Math.min(45,P.z+P.vz*dt));
if(cel&&cel.arr&&cel.k=='corner'&&P.y<=0)P.vy=4+R()*2;if(P.y>0||P.vy>0){P.vy-=G*dt;P.y+=P.vy*dt;if(P.y<=0){P.y=0;P.vy=0}}
