if(dl>.9){d.x+=dx/dl*ds*dt;d.z+=dz/dl*ds*dt}else if(P.y<1&&P.slow<=0){if(R()<.08&&A.state=='live')foul(d);P.slow=.6;P.vx+=-dx/dl*2;P.vz+=-dz/dl*2}
d.o.g.position.set(d.x,0,d.z);d.o.g.rotation.y=Math.atan2(dx,dz);anim(d.o,dt,ds,false);
if(A.state=='live'&&!A.shot&&!A.dribble&&!A.res&&A.type!='pen'&&A.type!='fk'&&A.type!='keep'&&d.cd<=0&&B.p.y<.5&&B.v.length()<14&&Math.hypot(B.p.x-d.x,B.p.z-d.z)<1.6&&R()<.04){slide(d,B.p.x,B.p.z);d.cd=2;B.v.set((B.p.x-d.x)*5,3,(B.p.z-d.z)*5+3);fin('miss',0,'WEGGETACKELD!')}
if(A.dribble&&!A.shot&&!A.res&&Math.hypot(B.p.x-d.x,B.p.z-d.z)<.85){if(R()<.08&&fl<1)foul(d);else{A.dribble=false;slide(d,B.p.x,B.p.z);fin('miss',0,'AFGEPAKT!')}}
if(A.state=='live'&&!A.dribble&&d.cd<=0&&Math.hypot(B.p.x-d.x,B.p.z-d.z)<.45&&B.p.y<1.7&&B.v.length()>3&&R()<.6){B.v.multiplyScalar(-.35);B.v.x+=(R()-.5)*4;d.cd=.5;thump(.3);if(A.shot&&!A.res){msg('Geblokt!',1)}}}
// ball touch by player
if(A.state=='live'&&!A.shot&&!A.dribble&&A.type!='pen'&&A.type!='fk'&&P.touch<=0){const dx=B.p.x-P.x,dz=B.p.z-P.z;if(Math.hypot(dx,dz)<.6&&B.p.y<P.y+1.7){const l=Math.hypot(dx,dz)||1;B.v.x=dx/l*3+P.vx*.5;B.v.z=dz/l*3+P.vz*.5;P.touch=.3;thump(.15)}}
// keeper
if(A.state=='live'||A.state=='res'){K.t+=dt;
if(A.type=='keep'&&A.shot&&!A.res){K.tx=A.guess?A.guess[0]:0;K.ty=A.guess?A.guess[1]:1}else if(A.type=='pen'&&A.shot&&!A.res){if(K.pd===undefined)K.pd=R()<.25?0:(R()<.5?-1:1)*2.4;K.tx=K.pd;K.ty=1.1}else if(A.shot&&!A.res&&K.t>0&&A.st!==undefined){A.st+=dt;if(A.st>K.rea&&B.v.z<-1){const tt=Math.max(0,(KZ-B.p.z)/B.v.z);K.tx=Math.max(-5,Math.min(5,B.p.x+B.v.x*tt));K.ty=Math.max(.5,Math.min(2.1,B.p.y+B.v.y*tt-.5*G*tt*tt))}}
else if(!A.shot){K.tx=Math.max(-1.5,Math.min(1.5,B.p.x*.3));K.ty=1}}
const kd=K.tx-K.x,kk=K.ks*(A.type=='pen'&&A.shot?1.9:A.type=='keep'&&A.shot?3:1);K.x+=Math.max(-kk*dt,Math.min(kk*dt,kd));K.y+=Math.max(-7*dt,Math.min(7*dt,K.ty-K.y));
const lean=Math.max(-1.2,Math.min(1.2,kd*.3)),up=A.shot?1:0;kp.g.position.set(K.x,Math.max(0,(K.y-1)*.8),KZ);kp.g.rotation.set(0,0,-lean);anim(kp,dt,0,false);
kp.armL.rotation.z=-2.6*up;kp.armR.rotation.z=2.6*up;if(A.shot&&(Math.abs(K.x)>1.1||K.y>1.5))K.dirt=Math.min(.45,(K.dirt||0)+dt*.8);kp.sm.color.setHex(0xc6ff00).lerp(new T.Color(0x6b4a2a),K.dirt||0);
if(A.shot&&!A.res&&B.p.z<KZ+1&&B.p.z>KZ-1.3&&Math.hypot(B.p.x-K.x,B.p.y-K.y)<K.reach){B.v.set((R()-.5)*8,3,3+R()*3);if(A.type=='keep'){goals++;sess+=100;save.xp+=100;celeb=1.5;cheer(.3,2);msg('GESAVED! +100',1.8);A.res=true;A.state='res';A.t=0;persist();hud()}else fin('save',0);thump(.6)}
// goal / out
if(!A.res&&A.state=='live'){const b=B.p;
if(A.type!='keep'&&A.shot&&b.z<GZ&&Math.abs(b.x)<3.62&&b.y<2.42){let p=100;const l=[],add=(n,t)=>{p+=n;l.push(t+' +'+n)};
if(A.acroT)add(A.acroT[2],A.acroT[1]);else if(A.kind=='Kopbal')add(30,'Kopbal');else if(A.kind=='Volley')add(40,'Volley');
if(A.speed>32)add(60,'Moeilijk schot');if(A.q>.75)add(50,'Perfecte timing');if(Math.abs(b.x)>2.7&&b.y>1.6)add(40,'Kruising!');
if(A.type=='dribble'||A.type=='box'||A.type=='team')add(A.type=='box'?60:A.type=='team'?200:80,A.type=='team'?'Heel elftal uitgespeeld':'Dribbelgoal');if(A.type=='long')add(60,'Afstandsschot');(A.type=='acro'&&!A.acroT)?fin('miss',0,'ALLEEN MET OMHAAL TELT!'):fin('goal',p*(A.type=='acro'?2:1),(l.join(' • ')||'Goal +100')+(A.type=='acro'?' • x2':''))}
else if(b.z<GZ-.5||Math.abs(b.x)>34||b.z>50||(A.t>(A.dribble?(A.type=='team'?45:20):9))||(A.t>3&&A.shot&&B.v.length()<.6&&b.y<.3)||(A.t>(A.type=='pen'||A.type=='fk'?15:4)&&!A.shot&&b.y<.3&&B.v.length()<.8)||(A.t>6&&!A.shot&&b.z>-36&&false))fin('miss',0,A.type=='keep'?'GOAL TEGEN!':undefined)}
if(A.state=='res'&&A.t>(cel?7.5:2.2))next();
// camera
celeb=Math.max(0,celeb-dt);shake=Math.max(0,shake-dt);
const tp=cel?V(cel.cam[0],cel.cam[1],cel.cam[2]):V(P.x*.7,5.5+P.y*.3,P.z+11);cam.position.lerp(tp,Math.min(1,dt*(cel?2.5:4)));cam.position.x+=(R()-.5)*shake*.3;cam.position.y+=(R()-.5)*shake*.3;cel?cam.lookAt(cel.x,1.4,cel.z):cam.lookAt(P.x*.5,1.5,P.z-16)}
function bstep(h){const b=B.p,v=B.v;v.y-=G*h;b.addScaledVector(v,h);v.multiplyScalar(1-.05*h);
if(b.y<.25){b.y=.25;if(v.y<-1.5)v.y*=-.62;else v.y=0;const f=Math.max(0,1-1.6*h);v.x*=f;v.z*=f}
if(b.z<GZ-2.4){b.z=GZ-2.4;v.z*=-.1;v.x*=.5}
