if(!run){cam.position.set(Math.sin(n*.0002)*25,12,-30+Math.cos(n*.0002)*8);cam.lookAt(0,2,-48)}
const ch=$('ch');if(run&&usedMouse){const a=A.guess||aimPt(),p=V(a[0],a[1],GZ).project(cam);ch.style.display='block';ch.style.borderColor=A.guess?'#4cff7a':'#ffd54f';ch.style.left=((p.x*.5+.5)*innerWidth)+'px';ch.style.top=((-p.y*.5+.5)*innerHeight)+'px'}else ch.style.display='none';
ring.scale.setScalar(1+.15*Math.sin(n*.008));rd.render(sc,cam)}
