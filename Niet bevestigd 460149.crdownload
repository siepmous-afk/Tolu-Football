const P={x:0,y:0,z:-28,vx:0,vy:0,vz:0,f:Math.PI,slow:0,acro:0,acroDone:1,kick:0,head:0,cd:0,touch:0};
const B={p:V(0,.25,0),v:V(0,0,0)};
const K={x:0,y:1,tx:0,ty:1,t:0,ks:5,rea:.35,reach:1.25};
let cel=null,A={state:'wait',t:0,res:true},side=1,tgt=[0,-46,1.5],celeb=0,shake=0,ca=0,mx=.5,my=.4,usedMouse=false,msgT;
const keys={},joy={x:0,y:0};let sprintBtn=false;
function msg(h,d=1.6){const m=$('msg');m.innerHTML=h;m.style.opacity=1;clearTimeout(msgT);msgT=setTimeout(()=>m.style.opacity=0,d*1000)}
// audio
let AC,cg,nb;
function audio(){if(AC){if(AC.state=='suspended')AC.resume();return}try{AC=new(window.AudioContext||window.webkitAudioContext)();const b=AC.createBuffer(1,AC.sampleRate*2,AC.sampleRate),d=b.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=R()*2-1;nb=b;
const s=AC.createBufferSource();s.buffer=b;s.loop=true;const f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=800;cg=AC.createGain();cg.gain.value=.07;s.connect(f);f.connect(cg);cg.connect(AC.destination);s.start();mt=setInterval(tick,114)}catch(e){}}
function tone(f,d,ty='sine',v=.2,f2){if(!AC)return;const o=AC.createOscillator(),g=AC.createGain();o.type=ty;o.frequency.value=f;if(f2)o.frequency.exponentialRampToValueAtTime(f2,AC.currentTime+d);g.gain.setValueAtTime(v,AC.currentTime);g.gain.exponentialRampToValueAtTime(.001,AC.currentTime+d);o.connect(g);g.connect(AC.destination);o.start();o.stop(AC.currentTime+d)}
function thump(v=.4){tone(160,.15,'sine',v,45)}
function cheer(l=.4,d=2.5){if(!cg)return;cg.gain.setTargetAtTime(l,AC.currentTime,.05);cg.gain.setTargetAtTime(.07,AC.currentTime+d,.5)}
let musicOn=true,mst=0,mt;const CH=[[0,3,7],[-4,0,3],[3,7,10],[-2,2,5]];
function tick(){if(!AC||!musicOn||AC.state!='running')return;const s=mst%16,ch=CH[(mst/16|0)%4];mst++;if(s%4==0)tone(130,.12,'sine',.18,45);if(s%2==0){tone(110*2**(ch[0]/12),.2,'triangle',.11);tone(440*2**(ch[[0,1,2,1,2,1,0,2][s>>1]]/12),.11,'square',.025)}if(s==4||s==12)tone(1900,.06,'square',.02)}
function whistle(){tone(2600,.25,'square',.05);setTimeout(()=>tone(2600,.4,'square',.05),300)}
// helpers
function skills(){const f=ST.f,s=[['SNEL',f],['SPRONG',f],['SCHOT',f],['TECHNIEK',f],['ACROBATIE',f]];
return s.map(a=>{const p=Math.round(10+90*a[1]);return`<div class="sk"><span>${a[0]}</span><i><em style="width:${p}%"></em></i><span>${p}%</span></div>`}).join('')}
function techs(){return'<ul>'+TECH.map(t=>`<li class="un ${save.lvl>=t[0]?'on':''}">${save.lvl>=t[0]?'✔':'🔒 level '+t[0]+' –'} ${t[1]}</li>`).join('')+'</ul>'}
function menu(title,body,btn,fn,extra=''){$('mc').innerHTML=`<h1>${title}</h1>${body}<h2>Volgend: ${LT[ltype(save.lvl)][0]}</h2><p>${LT[ltype(save.lvl)][1]}</p><h2>Vaardigheden – ${NAMES(save.lvl)} (level ${save.lvl}/200)</h2>${skills()}<h2>Technieken</h2>${techs()}<button class="go" id="gb">${btn}</button><button class="sm sec" id="cb">👕 Club: ${(CLUBS.find(x=>x.id==save.club)||CLUBS[0]).n}</button><button class="sm sec" id="sh">🛒 Shop – ${save.coins} coins</button><button class="sm" id="rs">🔄 Reset: helemaal opnieuw beginnen</button>${extra}`;
$('menu').classList.remove('h');$('gb').onclick=()=>{audio();fn()};$('sh').onclick=()=>shop(title,body,btn,fn,extra);$('cb').onclick=()=>clubScreen(()=>menu(title,body,btn,fn,extra));const r=$('rs');if(r)r.onclick=()=>{if(!r.dataset.s){r.dataset.s=1;r.textContent='⚠ Zeker weten? Klik nogmaals om ALLES te wissen';r.style.color='#ff8a80';return}save={lvl:1,xp:0,best:0,coins:0,owned:['tolu'],sel:'tolu',club:'ajax',fix:1,gift:1,fails:0};persist();ST=st(1);sess=0;applyClub();skin();intro()}}
function shop(t,bd,bt,fn,ex){const pc=v=>Math.round(v*100),rows=PL.slice().sort((a,b)=>a.p-b.p).map(p=>{const own=save.owned.includes(p.id),sel=save.sel==p.id;
return`<div class="pl"><div><b>${p.n}</b><br><small>${p.p?`Snelheid +${pc(p.sp)}% • Kracht +${pc(p.pw)}% • Techniek +${pc(p.te)}% • Sprong +${pc(p.ju)}%`:'Basisspeler'}</small></div><button data-id="${p.id}" class="${sel?'on':''}">${sel?'Gekozen':own?'Kies':'Koop '+p.p+' 🪙'}</button></div>`}).join('');
$('mc').innerHTML=`<h1>Shop</h1><p>Je hebt <b>🪙 ${save.coins}</b> coins. Elk gehaald level levert 10 coins op. Iedereen speelt in een Ajax-shirt.</p>${rows}<button class="go" id="bk">Terug</button>`;
$('bk').onclick=()=>menu(t,bd,bt,fn,ex);
document.querySelectorAll('.pl button').forEach(b=>b.onclick=()=>{const p=PL.find(x=>x.id==b.dataset.id);if(!save.owned.includes(p.id)){if(save.coins<p.p){b.textContent='Te weinig coins';return}save.coins-=p.p;save.owned.push(p.id)}save.sel=p.id;persist();ST=st(save.lvl);skin();hud();t.includes('hero')?intro():menu(t,bd,bt,fn,ex)})}
function hud(){$('pl').textContent=`${NAMES(save.lvl)} • Level ${save.lvl}`;$('sc').textContent=`Score ${sess} • XP ${save.xp} • 🪙 ${save.coins}`;$('gl').textContent=`Goals ${goals}/${need}`;$('at').textContent=`Kans ${Math.min(att+1,5)}/5 • ${LT[LTYPE][0]}`;
$('xp').style.width=((save.lvl-1+goals/need)/200*100)+'%'}
function skin(){const p=PL.find(x=>x.id==save.sel)||PL[0];banner(p.n);me.sk.color.setHex(p.sk);me.hr.color.setHex(p.hc);me.cap.visible=p.hs!=1;me.cap.scale.setScalar(p.hs==7?.93:1);me.bike.visible=p.id=='siem';me.stick.visible=p.id=='sjoerd';me.pt.visible=p.hs==8;me.pv.position.y=p.id=='siem'?1.1:.9;(me.locs||[]).forEach(d=>d.visible=p.hs==2);me.fr[0].visible=p.hs==3;me.qf[0].visible=p.hs==5||p.hs==6;me.sd.forEach(m=>{m.visible=p.hs==4||p.hs==6;m.scale.set(p.hs==6?1.6:1,p.hs==6?1.3:1,p.hs==6?1.25:1)});me.ln[0].visible=p.hs==4||p.hs==6;{const k=(1+ST.f*.08)*(p.id=='sem'?.75:1),w=p.id=='jorin'?1.38:1;me.g.scale.set(k*w,k,k*w)}}
// flow
function startLevel(){ST=st(save.lvl);LTYPE=ltype(save.lvl);att=0;setRain(R()<.22);fl=0;K.dirt=0;df.forEach(d=>{d.red=0;d.yc=0});goals=0;lvlPts=0;need=save.lvl>=50?3:2;K.ks=3.4+ST.f*3;K.rea=.5-ST.f*.2;K.reach=1+ST.f*.22;
skin();$('menu').classList.add('h');run=true;whistle();startAttempt();msg(`Level ${save.lvl}: ${LT[LTYPE][0]}<small>${LT[LTYPE][1]}${raining?' • 🌧 Het regent!':''} – scoor ${need} van de 5</small>`,3.4)}
function startAttempt(){side=R()<.5?-1:1;A={state:'wait',t:0,res:false,shot:false,type:LTYPE};tgt=[(R()-.5)*7,GZ+5+R()*4,.9+R()*2.1];const ty=LTYPE,dr=ty=='dribble'||ty=='box'||ty=='team';if(ty=='head')tgt[2]=2.3+R()*.7;if(ty=='acro')tgt[2]=1.6+R()*.8;if(ty=='low'||ty=='long')tgt[2]=.3;if(ty=='long')tgt[1]=-22;let cx=side*27,cz=-44;if(ty=='long'){cx=side*16;cz=-27}
cr.g.position.set(cx,0,cz);cr.g.rotation.y=Math.atan2(tgt[0]-cx,tgt[1]-cz);B.p.set(cx+(side>0?-.5:.5),.25,cz);B.v.set(0,0,0);cr.g.visible=!dr&&ty!='pen'&&ty!='fk';
Object.assign(P,{x:0,y:0,z:ty=='long'?-19:ty=='dribble'?-12:ty=='box'?-36:ty=='pen'?-39.8:ty=='team'?8:-37,vx:0,vy:0,vz:0,acro:0,kick:0,head:0,slow:0,cd:0,sw:null});
const nd=ty=='pen'||ty=='keep'?0:ty=='fk'?3:ty=='team'?10:ty=='box'?2:ty=='dribble'||ty=='battle'?Math.min(4,3+(save.lvl/50|0)):Math.min(4,2+(save.lvl/35|0));df.forEach((d,i)=>{d.sl=null;d.o.pv.rotation.x=0;d.o.pv.position.y=.9;d.on=i<nd&&!d.red;d.o.g.visible=d.on;d.x=ty=='team'?(R()-.5)*34:ty=='box'?(i?3.5:-3.5)+(R()-.5)*2:ty=='battle'?tgt[0]+(R()-.5)*6:(i-(nd-1)/2)*6+(R()-.5)*3;d.z=ty=='team'?-4-i*3.6+R()*1.5:ty=='box'?-41.5-i*2:ty=='battle'?tgt[1]+(R()-.5)*3:ty=='dribble'?-26-i*4+R()*2:ty=='long'?-34+R()*3:-38+R()*4;d.cd=0});
Object.assign(K,{x:0,y:1,tx:0,ty:1,t:0,pd:undefined});ring.position.set(tgt[0],.03,tgt[1]);wear(att);cardM.visible=false;ring.visible=!dr&&ty!='pen';if(dr){A.state='live';A.dribble=true;B.p.set(0,.25,P.z-.8)}if(ty=='pen'){A.state='live';B.p.set(0,.25,-41.5)}
me.g.visible=ty!='keep';if(ty=='fk'||ty=='keep')ring.visible=false;
if(ty=='fk'){const d=16+R()*14,bx=(R()-.5)*24,bz=GZ+d;A.state='live';B.p.set(bx,.25,bz);P.x=bx;P.z=bz+1.8;const ln=Math.hypot(-bx,GZ-bz),ux=-bx/ln,uz=(GZ-bz)/ln;df.forEach((w,i)=>{if(i<3){w.x=bx+ux*9.15+(-uz)*(i-1)*.75;w.z=bz+uz*9.15+ux*(i-1)*.75;w.on=true;w.o.g.visible=true}})}
if(ty=='keep'){const bx=(R()-.5)*16,bz=GZ+14+R()*8;A.state='live';B.p.set(bx,.25,bz);P.x=bx;P.z=bz+6;cr.g.position.set(bx,0,bz+3);cr.g.rotation.y=Math.PI;A.bz=bz+3;A.guess=null}
hud()}
function cross(){A.state='live';A.t=0;const gp=A.type=='low'||A.type=='long',Tf=gp?1.2:(2.2-ST.f*.5)*(A.type=='turbo'?.6:1),sx=B.p.x,sz=B.p.z;if(gp){const dx=tgt[0]-sx,dz=tgt[1]-sz,L=Math.hypot(dx,dz)||1,s=L/((1-Math.exp(-1.6*Tf))/1.6);B.v.set(dx/L*s,0,dz/L*s)}else B.v.set((tgt[0]-sx)/Tf,(tgt[2]-.3+.5*G*Tf*Tf)/Tf,(tgt[1]-sz)/Tf);cr.kick=.3;thump(.5)}
function fin(r,p,txt){A.res=true;A.state='res';A.t=0;ring.visible=false;
if(r=='goal'){A.goal=true;goals++;if(goals==2&&A.type!='keep')startCel();sess+=p;lvlPts+=p;save.xp+=p;save.best=Math.max(save.best,sess);celeb=2.5;shake=1.2;cheer(.4,2.6);thump(.6);msg(`DOELPUNT! +${p}<small>${txt}</small>`,2.2)}
else{cheer(.15,1.2);msg(txt||(r=='save'?'GESAVED!':'MIS!'),1.5)}persist();hud()}
function oppShot(){const tx=(R()-.5)*6.4,ty=.3+R()*1.8,S=21+ST.f*10,hx=tx-B.p.x,hz=GZ-B.p.z,hd=Math.hypot(hx,hz),t=Math.min(hd/S,.2+hd/50);B.v.set(hx/t,(ty-B.p.y+.5*G*t*t)/t,hz/t);A.shot=true;A.st=0;A.t=0;cr.kick=.3;thump(.8)}
function slide(d,tx,tz){const dl=Math.hypot(tx-d.x,tz-d.z)||1;d.sl={t:0,dx:(tx-d.x)/dl,dz:(tz-d.z)/dl}}
function foul(d){if(A.res||A.shot||fl>=1)return;fl++;d.yc=(d.yc||0)+1;const red=d.yc>=2||R()<.3;if(red){d.red=1;const dl=Math.hypot(P.x-d.x,P.z-d.z)||1;d.sl={t:0,dx:(P.x-d.x)/dl,dz:(P.z-d.z)/dl}}A.foul=true;A.res=true;A.dribble=false;A.state='res';A.t=0;ring.visible=false;whistle();cardM.position.set(d.x,2.8,d.z);cardM.material.color.setHex(red?0xe53935:0xffeb3b);cardM.visible=true;msg((red?'RODE KAART!':'GELE KAART!')+'<small>Overtreding van de verdediger – je krijgt een nieuwe kans</small>',2.2)}
const CELS=[['corner','Hoekvlag-vreugde met de fans'],['siuuu','SIUUU!'],['dab','De Dab'],['floss','The Floss'],['griddy','De Griddy'],['knee','Kniesliding'],['messi','Messi wijst naar de hemel'],['salto','Salto!'],['haal','Haaland-meditatie'],['cross','Armen over elkaar'],['heart','Het hartje'],['robot','De Robot'],['sprinkler','De Sprinkler'],['shh','Shhh!'],['plane','Vliegtuigje']];let lastCel=-1;
function startCel(){let i;do{i=R()*CELS.length|0}while(i==lastCel);lastCel=i;const k=CELS[i][0],s=P.x>=0?1:-1;cel={k,x:s*31.5,z:-49.5,t:0,cam:[s*29,2.1,-44.5]}}
function celAnim(dt){if(cel.at===undefined){cel.at=cel.t;msg(CELS.find(c=>c[0]==cel.k)[1]+'!',2.4)}
const t=cel.t-cel.at,k=cel.k,s=Math.sin(t*10),sg=(a,b)=>Math.min(1,Math.max(0,(t-a)/b)),al=me.armL,ar=me.armR,ll=me.legL,lr=me.legR,pv=me.pv;
if(k=='siuuu'){if(t>.3&&!cel.j){cel.j=1;P.vy=7.5}me.g.rotation.y=P.f+Math.PI*2*sg(.3,.65);if(t>1){al.rotation.set(0,0,-.9);ar.rotation.set(0,0,.9);pv.rotation.x=-.15}else{al.rotation.z=-.3;ar.rotation.z=.3}}
else if(k=='dab'){ar.rotation.set(-2.3,0,-.6);al.rotation.set(0,0,-2.5);pv.rotation.z=.18;pv.position.y=.9+Math.abs(Math.sin(t*6))*.04}
else if(k=='floss'){al.rotation.set(-1,0,s);ar.rotation.set(-1,0,s);pv.rotation.z=-s*.22;ll.rotation.x=s*.15;lr.rotation.x=-s*.15}
else if(k=='griddy'){ll.rotation.x=s*.7;lr.rotation.x=-s*.7;al.rotation.set(-1.3,0,s*.5);ar.rotation.set(-1.3,0,s*.5);pv.rotation.x=.3;pv.position.y=.82+Math.abs(s)*.06}
else if(k=='knee'){if(t<1.2)P.z+=(5-4*t)*dt;pv.position.y=.5;ll.rotation.x=lr.rotation.x=1.2;al.rotation.set(0,0,-1.4);ar.rotation.set(0,0,1.4);pv.rotation.x=-.25}
else if(k=='messi'){al.rotation.set(0,0,-2.7);ar.rotation.set(0,0,2.7);pv.rotation.x=-.3+Math.sin(t*3)*.03}
else if(k=='salto'){if(t>.3&&!cel.j){cel.j=1;P.vy=8.5}pv.rotation.x=-Math.PI*2*sg(.3,.7);al.rotation.set(-2.5,0,0);ar.rotation.set(-2.5,0,0)}
else if(k=='cross'){al.rotation.set(-1.7,0,.9);ar.rotation.set(-1.7,0,-.9);pv.rotation.x=-.1}
else if(k=='heart'){al.rotation.set(-2.7,0,.4);ar.rotation.set(-2.7,0,-.4);pv.position.y=.9+Math.abs(Math.sin(t*5))*.05}
else if(k=='robot'){const q=Math.floor(t*4)%2;al.rotation.set(-1.57,0,q?0:-.9);ar.rotation.set(-1.57,0,q?.9:0);ll.rotation.x=q?.4:-.4;lr.rotation.x=q?-.4:.4}
else if(k=='sprinkler'){ar.rotation.set(0,0,1.4+(t*2%1)*1.2);al.rotation.set(-.3,0,-.2);pv.rotation.x=-.15}
else if(k=='shh'){ar.rotation.set(-2.4,0,-.3);al.rotation.set(-.3,0,-.3)}
else if(k=='plane'){al.rotation.set(0,0,-1.5);ar.rotation.set(0,0,1.5);pv.rotation.z=Math.sin(t*2)*.35}
else if(k=='haal'){pv.position.y=.45;ll.rotation.x=lr.rotation.x=-1.5;al.rotation.set(-.8,0,-.3);ar.rotation.set(-.8,0,.3)}}
function next(){cel=null;pile.forEach(o=>o.g.visible=false);me.pv.rotation.z=0;skin();if(A.foul){startAttempt();return}att++;if(att>=5)lvlEnd();else startAttempt()}
function lvlEnd(){run=false;const ok=goals>=need;
if(ok){save.fails=0;save.coins+=10;const old=save.lvl;if(save.lvl<200)save.lvl++;persist();ST=st(save.lvl);const nu=TECH.filter(t=>t[0]>old&&t[0]<=save.lvl).map(t=>t[1]);
menu(save.lvl==200&&old==200?'Tolu blijft de beste!':'Level behaald! 🎉',`<p>${goals} goals • ${lvlPts} XP verdiend dit level. <b style="color:#ffd54f">+10 🪙 coins</b> (totaal ${save.coins}).<br>Je bent nu <b>${NAMES(save.lvl)}</b> (level ${save.lvl}).${nu.length?'<br><b style="color:#9be58b">Nieuwe techniek: '+nu.join(', ')+'</b>':''}</p>`,save.lvl>=200&&old==200?'Speel opnieuw level 200':'Volgende level',startLevel)}
else{save.fails=(save.fails||0)+1;let t='';if(save.fails>=3){save.fails=0;if(save.lvl>1){save.lvl--;ST=st(save.lvl);t='<br><b style="color:#ff8a80">3 keer niet gehaald: je gaat terug naar level '+save.lvl+'.</b>'}else t='<br>3 keer niet gehaald.'}else t='<br>Poging '+save.fails+' van 3 mislukt.';persist();menu('Net niet!',`<p>${goals} van de ${need} benodigde goals. ${t}</p>`,'Opnieuw proberen',startLevel)}}
function intro(){const l=save.lvl;menu(`<div class='hero'><div class='logo'>⚽ TOLU<span>FOOTBALL.NL</span></div><div class='tag'>Scoor spectaculaire goals uit voorzetten • 200 levels</div></div>`,`<div class='tiles'><div><b>${l}</b>LEVEL</div><div><b>🪙 ${save.coins}</b>COINS</div><div><b>${save.xp}</b>XP</div></div><h2>Besturing</h2><div class='keys'><div><kbd>W A S D</kbd>bewegen</div><div><kbd>Spatie</kbd>springen</div><div><kbd>Shift</kbd>sprinten</div><div><kbd>Klik</kbd>schieten (of Q)</div><div><kbd>H</kbd>koppen</div><div><kbd>E</kbd>omhaal (vanaf level 10)</div><div><kbd>Muis</kbd>richt in het doel</div><div><kbd>Tik</kbd>op het doel = schieten (mobiel)</div></div><p style='margin-top:8px'>Het gele ringetje laat zien waar je op mikt. Verdien 10 coins per level en koop echte spitsen in de shop! M = muziek aan/uit.</p>`,l>1?'▶ VERDER SPELEN':'▶ SPEEL!',clubScreen,((document.documentElement.requestFullscreen&&!(navigator.standalone||matchMedia('(display-mode:standalone)').matches))?'<button class="sm sec" onclick="document.documentElement.requestFullscreen()">⛶ Volledig scherm</button>':''))}
function clubScreen(bk){$('mc').innerHTML=`<h1>Kies je club</h1><p>Je spits en alle supporters dragen het shirt van je club.</p><div class='cl'>${CLUBS.map(c=>`<button data-c='${c.id}' class='${save.club==c.id?'on':''}'><i style='background:${kitCss(c)}'></i>${c.n}</button>`).join('')}</div><button class='go' id='cg'>${bk?'Terug':'▶ START'}</button>`;
document.querySelectorAll('.cl button').forEach(b=>b.onclick=()=>{save.club=b.dataset.c;persist();applyClub();clubScreen(bk)});$('cg').onclick=()=>{audio();bk?bk():startLevel()}}
function introOld(){menu('TOLU FOOTBALL.NL',`<p>Eén spits, jij. Je teamgenoot geeft voorzetten – timing is alles. Scoor ${need} van de 5 per level en word met <b>Tolu</b> steeds beter van level 1 tot level 100.</p>
<h2>Besturing</h2><p>PC: WASD/pijlen = bewegen • Spatie = springen • Shift = sprinten • Linkermuisknop of Q = schieten • H = koppen (spring en raak de bal echt met je hoofd) • richt met de muis in het doel (het gele ringetje laat zien waar je op mikt) • E = acrobatische actie (omhaal, vanaf level 10) • M = muziek aan/uit. Mobiel: knoppen op het scherm.</p>`,save.lvl>1?'Verder spelen':'Speel!',startLevel,'<button class="sm" id="rs">Begin opnieuw</button>')}
// actions
function aimPt(){if(!usedMouse)return[(K.x>0?-1:1)*2.9,.7+R()*1];const v=V(mx*2-1,-(my*2-1),.5).unproject(cam).sub(cam.position).normalize();if(v.z>-.01)return[0,1];const t=(GZ-cam.position.z)/v.z;return[Math.max(-3.3,Math.min(3.3,cam.position.x+v.x*t)),Math.max(.3,Math.min(2.15,cam.position.y+v.y*t))]}
function hit(kind,q,pw){const[ax,ay]=P.aim||aimPt(),e=(1.15-ST.tech)*(1.3-q)*1.5;P.aim=null;
const tx=ax+(R()-.5)*2*e,ty=ay+(R()-.5)*e*.8,S=ST.power*pw*(.65+.35*q)*(save.lvl>=100&&save.sel=='tolu'?1.4:1),hx=tx-B.p.x,hz=GZ-B.p.z,hd=Math.max(Math.hypot(hx,hz),.5),t=Math.min(hd/S,.2+hd/50);
B.v.set(hx/t,(ty-B.p.y+.5*G*t*t)/t,hz/t);Object.assign(A,{shot:true,kind,q,speed:B.v.length(),st:0,t:0});thump(.8);tone(900,.05,'square',.04)}
function shoot(){if(!run||A.state!='live'||A.res||A.shot||P.cd>0)return;if(A.type=='keep'){A.guess=aimPt();msg('Keeper duikt hierheen!',.8);return}P.aim=aimPt();if(A.dribble){A.dribble=false;P.cd=.35;P.kick=.25;hit(P.y>.3?'Volley':'Schot',.85,1);return}P.cd=.35;P.kick=.25;P.sw={k:'foot',t:0,a:.08,b:.3,done:0};


}
function header(){if(!run||A.state!='live'||A.res||A.shot||P.cd>0)return;P.aim=aimPt();P.cd=.35;P.head=.35;P.sw={k:'head',t:0,a:.1,b:.34,done:0}}
function jump(){if(run&&P.y<=0)P.vy=ST.jump}
function acro(){if(!run||A.res||A.shot||P.acro>0)return;if(save.lvl<10){msg('Omhaal vanaf level 10',1.2);return}if(P.y<.35){msg('Spring eerst: een omhaal doe je in de lucht!',1.5);return}P.aim=aimPt();P.acro=.8;P.acroDone=0}
// input
