<!DOCTYPE html><html lang="nl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="theme-color" content="#07131f">
<title>TOLU FOOTBALL.NL</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-180.png">
<meta name="application-name" content="Tolu Football">
<meta name="apple-mobile-web-app-title" content="Tolu Football">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="format-detection" content="telephone=no">
<meta name="description" content="TOLU FOOTBALL.NL - 3D voetbalgame: scoor spectaculaire goals uit voorzetten.">
<style>
:root{color-scheme:dark;box-sizing:border-box}
*{box-sizing:border-box;margin:0}
html,body{height:100%;overflow:hidden;background:#07131f;color:#fff;font-family:system-ui,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
#top{position:fixed;top:0;left:0;right:0;display:flex;gap:6px 16px;flex-wrap:wrap;align-items:center;padding:calc(env(safe-area-inset-top,0px) + 8px) 12px 6px;background:linear-gradient(#000a,#0000);font-size:14px;pointer-events:none}
#top b{color:#ffb300;letter-spacing:1px}
#xpw{position:fixed;top:calc(env(safe-area-inset-top,0px) + 44px);left:12px;right:12px;height:6px;background:#fff3;border-radius:3px;pointer-events:none}
#xp{height:100%;background:#ffb300;border-radius:3px;width:0;transition:width .4s}
#rot{display:none;position:fixed;left:0;right:0;bottom:8px;text-align:center;font-size:12px;color:#ffe082;z-index:3;pointer-events:none}
@media (orientation:portrait) and (pointer:coarse){#rot{display:block}}
@media (max-width:760px){#top{font-size:11px;gap:4px 10px}.card{padding:14px}.logo{font-size:36px}#msg{top:22%}}
#fl{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:2;transition:opacity .07s}
#ch{position:fixed;width:34px;height:34px;margin:-17px 0 0 -17px;border:3px solid #ffd54f;border-radius:50%;pointer-events:none;display:none;z-index:2;box-shadow:0 0 8px #000a}#ch:after{content:'';position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px;background:#ffd54f;border-radius:50%}
#msg{position:fixed;top:28%;left:0;right:0;text-align:center;font-size:clamp(28px,7vw,64px);font-weight:900;text-shadow:0 3px 12px #000;pointer-events:none;opacity:0;transition:opacity .25s;padding:0 10px}
#msg small{display:block;font-size:.3em;font-weight:600;color:#ffe082;margin-top:6px}
.ov{position:fixed;inset:0;background:radial-gradient(ellipse at center,#0a1e3a99,#02070fe6);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:14px;z-index:5;overflow:auto;touch-action:pan-y}
.ov.h{display:none}
.card{background:linear-gradient(160deg,#10294a,#0a1627);box-shadow:0 0 60px #ffb30033,0 20px 60px #000a;border:1px solid #ffb30088;border-radius:16px;padding:20px;max-width:580px;width:100%;max-height:100%;overflow:auto}
h1{color:#ffb300;font-size:26px;margin-bottom:4px}
h2{font-size:15px;margin:14px 0 6px;color:#ffe082}
p,li{font-size:14px;line-height:1.5;color:#cfd8e3}
ul{padding-left:18px}
.sk{display:grid;grid-template-columns:90px 1fr 40px;gap:8px;align-items:center;font-size:12px;margin:3px 0}
.sk i{display:block;height:8px;border-radius:4px;background:#ffffff22;overflow:hidden}
.sk i em{display:block;height:100%;background:linear-gradient(90deg,#ff7043,#ffd54f)}
.un{color:#7a8a9c}.un.on{color:#9be58b}
button.go{margin-top:16px;width:100%;padding:16px;border:0;border-radius:12px;background:linear-gradient(#ffd54f,#ff9800);box-shadow:0 6px 0 #a35f00;color:#111;font-size:19px;font-weight:900;letter-spacing:1px;cursor:pointer;animation:pu 1.6s infinite}
@keyframes pu{50%{transform:scale(1.025)}}
.hero{text-align:center;margin-bottom:6px}.logo{font-size:clamp(34px,9vw,58px);font-weight:900;letter-spacing:2px;line-height:1;background:linear-gradient(#fff,#ffb300);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 3px 0 #7a3a00)}.logo span{display:block;font-size:.38em;letter-spacing:7px;color:#fff;-webkit-text-fill-color:#fff;margin-top:4px}.tag{color:#ffe082;font-size:13px;margin-top:8px}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}.tiles div{background:#ffffff14;border-radius:10px;padding:10px;text-align:center;font-size:10px;letter-spacing:1px;color:#9fb3c8}.tiles b{display:block;font-size:20px;color:#fff;letter-spacing:0}
.keys{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;font-size:12px;color:#cfd8e3}.keys kbd{display:inline-block;min-width:26px;padding:2px 7px;border-radius:5px;background:#fff;color:#111;font-weight:700;font-size:11px;margin-right:6px;text-align:center}
button.sm.sec{color:#fff;text-decoration:none;border:1px solid #fff4;background:#ffffff14;padding:9px 14px;border-radius:9px;font-size:13px;margin:10px 6px 0 0}
.cl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.cl button{display:flex;align-items:center;gap:10px;padding:10px;border:2px solid #ffffff22;border-radius:10px;background:#ffffff0d;color:#fff;font-weight:700;font-size:13px;cursor:pointer;text-align:left}.cl button.on{border-color:#ffb300;background:#ffb30026}.cl i{width:30px;height:34px;border-radius:6px 6px 3px 3px;border:1px solid #fff5;display:block;flex:none}
.pl{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #ffffff1a}.pl button{padding:8px 12px;border:0;border-radius:8px;background:#ffb300;color:#111;font-weight:700;cursor:pointer;white-space:nowrap}.pl button.on{background:#2e7d32;color:#fff}.pl small{color:#8fa3b8}
button.sm{margin-top:8px;background:none;border:0;color:#7a8a9c;font-size:12px;cursor:pointer;text-decoration:underline}
#touch{display:none;position:fixed;inset:0;pointer-events:none;z-index:3}
#touch.on{display:block}
#joy{position:absolute;left:calc(env(safe-area-inset-left,0px) + 20px);bottom:calc(env(safe-area-inset-bottom,0px) + 24px);width:130px;height:130px;border-radius:50%;background:#fff2;border:2px solid #fff5;pointer-events:auto}
#kn{position:absolute;left:35px;top:35px;width:60px;height:60px;border-radius:50%;background:#ffb300cc}
.b{position:absolute;border-radius:50%;background:#ffffff26;border:2px solid #fff7;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;pointer-events:auto;text-align:center}
.b:active,.b.d{background:#ffb300aa}
#bs{right:calc(env(safe-area-inset-right,0px) + 20px);bottom:calc(env(safe-area-inset-bottom,0px) + 30px);width:92px;height:92px;font-size:15px}
#bj{right:calc(env(safe-area-inset-right,0px) + 126px);bottom:calc(env(safe-area-inset-bottom,0px) + 24px);width:70px;height:70px}
#ba{right:calc(env(safe-area-inset-right,0px) + 30px);bottom:calc(env(safe-area-inset-bottom,0px) + 134px);width:70px;height:70px}
#bh{right:calc(env(safe-area-inset-right,0px) + 206px);bottom:calc(env(safe-area-inset-bottom,0px) + 40px);width:64px;height:64px}
#bp{right:calc(env(safe-area-inset-right,0px) + 112px);bottom:calc(env(safe-area-inset-bottom,0px) + 104px);width:64px;height:64px}
html,body{overscroll-behavior:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
#ins{position:fixed;left:10px;right:10px;bottom:calc(env(safe-area-inset-bottom,0px) + 10px);z-index:8;background:#ffb300;color:#111;padding:10px 38px 10px 12px;border-radius:12px;font:600 13px system-ui,sans-serif;box-shadow:0 6px 24px #000a}
#insx{position:absolute;right:12px;top:8px;font-size:18px;cursor:pointer}
</style></head><body>
<canvas id="c"></canvas><div id="ld" style="position:fixed;inset:0;z-index:9;background:#07131f;display:flex;align-items:center;justify-content:center;text-align:center;font:900 26px system-ui,sans-serif;color:#ffb300;line-height:1.5">⚽ TOLU FOOTBALL.NL<br><small style="font-size:14px;color:#cfd8e3">laden...</small></div><div id="rot">📱 Draai je telefoon voor het beste beeld</div>
<div id="top"><b>TOLU FOOTBALL.NL</b><span id="pl"></span><span id="sc"></span><span id="gl"></span><span id="at"></span></div>
<div id="xpw"><div id="xp"></div></div>
<div id="msg"></div><div id="ch"></div><div id="fl"></div>
<div id="touch"><div id="joy"><div id="kn"></div></div>
<div class="b" id="bs">SCHIET</div><div class="b" id="bj">SPRING</div><div class="b" id="ba">ACRO</div><div class="b" id="bp">SPRINT</div><div class="b" id="bh">KOP</div></div>
<div id="menu" class="ov"><div class="card" id="mc"></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const $=id=>document.getElementById(id),MOB=/Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent)||matchMedia('(pointer:coarse)').matches||innerWidth<800,T=THREE,G=20,GZ=-52.5,KZ=GZ+.7,V=(x,y,z)=>new T.Vector3(x,y,z),R=Math.random;
let save={lvl:1,xp:0,best:0,coins:0,owned:['tolu'],sel:'tolu',club:'ajax'};try{Object.assign(save,JSON.parse(localStorage.getItem('tolu')||'{}'))}catch(e){}
const persist=()=>{try{localStorage.setItem('tolu',JSON.stringify(save))}catch(e){}};
if(!save.fix){save.fix=1;save.gift=1;save.coins=100;persist()}
const NAMES=l=>(PL.find(x=>x.id==save.sel)||PL[0]).n;
const PL=[['tolu','Tolu',0,0x4a2c17,0x111111,2,0,0,0,0],['sybrand','Sybrand van Gils',300,0xe6bb94,0xe3c35a,6,.06,.06,.06,.06],['tim','Tim Teunissen',75,0xe6bb94,0x4a3220,0,.03,.03,.03,.03],['phil','Phileine van Gerven',125,0xe6bb94,0xe3c35a,8,.03,.03,.04,.03],['sjoerd','Sjoerd Bouwmans',150,0xe6bb94,0x5a3d1f,0,.03,.04,.03,.03],['jorin','Jorin Dijkstra',175,0xe6bb94,0x5a3a1e,0,.02,.06,.03,.02],['hermsen','Jens Hermsen',250,0xe6bb94,0x3b2a1a,0,.05,.06,.05,.05],['siem','Siem van der Locht',100,0xe6bb94,0x5a3d1f,0,.03,.03,.03,.03],['sem','Sem Heitling',225,0xe6bb94,0xe3c35a,3,.03,.03,.02,.03],['siep','Siep Mous',300,0xe6bb94,0x9a7448,4,.06,.06,.06,.06],['marcos','Marcos Leonardo',600,0xd4a578,0x1a1008,0,.06,.07,.06,.05],['brobbey','Brian Brobbey',650,0x1c120d,0x050505,7,.05,.05,.04,.04],['dejong','Luuk de Jong',350,0xe6bb94,0xc8a15a,0,.02,.05,.05,.09],['weghorst','Wout Weghorst',400,0xe6bb94,0xa07848,0,.02,.08,.05,.08],['gakpo','Cody Gakpo',500,0x7a4b2a,0x111111,0,.08,.07,.07,.05],['depay','Memphis Depay',450,0x7a4b2a,0x222222,0,.08,.09,.09,.06],['vanpersie','Robin van Persie',750,0xe6bb94,0x3b2a1a,0,.08,.1,.12,.07],['bergkamp','Dennis Bergkamp',700,0xe6bb94,0x3b2a1a,0,.08,.08,.16,.08],['vanbasten','Marco van Basten',800,0xe6bb94,0xc8a15a,0,.1,.12,.16,.1],['zlatan','Zlatan Ibrahimović',550,0xc99a72,0x3b2a1a,0,.1,.15,.15,.14],['cruyff','Johan Cruyff',950,0xe6bb94,0x8a6a3a,0,.13,.12,.2,.12],['ronaldo9','Ronaldo Nazário',900,0xa8704a,0x111111,0,.16,.18,.18,.12],['messi','Lionel Messi',1050,0xe0b48a,0x6b4a2a,0,.17,.16,.24,.12],['cr7','Cristiano Ronaldo',1100,0xdfae85,0x2a1a10,0,.16,.2,.18,.18],['mbappe','Kylian Mbappé',1000,0x7a4b2a,0x111111,0,.22,.2,.2,.15],['haaland','Erling Haaland',850,0xe6bb94,0xc8a15a,0,.15,.26,.15,.2]].map(a=>({id:a[0],n:a[1],p:a[2],sk:a[3],hc:a[4],hs:a[5],sp:a[6],pw:a[7],te:a[8],ju:a[9]}));
const CLUBS=[['ajax','Ajax','c','#ffffff','#d2122e','#ffffff','#ffffff'],['psv','PSV','v','#e30613','#ffffff','#ffffff','#e30613'],['fey','Feyenoord','h','#e2001a','#ffffff','#111111','#111111'],['rma','Real Madrid','p','#ffffff','#ffffff','#ffffff','#ffffff'],['fcb','FC Barcelona','v','#a50044','#004d98','#0a2a5a','#004d98'],['mun','Manchester United','p','#da291c','#da291c','#ffffff','#111111'],['liv','Liverpool','p','#c8102e','#c8102e','#c8102e','#c8102e'],['bay','Bayern München','p','#dc052d','#dc052d','#ffffff','#dc052d'],['juv','Juventus','v','#ffffff','#111111','#111111','#ffffff'],['psg','Paris Saint-Germain','c','#0b1f4a','#d2122e','#0b1f4a','#0b1f4a']].map(a=>({id:a[0],n:a[1],s:a[2],a:a[3],b:a[4],sh:a[5],so:a[6]}));
const kitCss=c=>c.s=='c'?`linear-gradient(90deg,${c.a} 33%,${c.b} 33% 67%,${c.a} 67%)`:c.s=='v'?`repeating-linear-gradient(90deg,${c.a} 0 6px,${c.b} 6px 12px)`:c.s=='h'?`linear-gradient(90deg,${c.a} 50%,${c.b} 50%)`:c.a;
function drawKit(x,w,h,k){x.fillStyle=k.a;x.fillRect(0,0,w,h);x.fillStyle=k.b;if(k.s=='c')x.fillRect(w*.34,0,w*.32,h);else if(k.s=='v'){const sw=w/6;for(let i=1;i<6;i+=2)x.fillRect(i*sw,0,sw,h)}else if(k.s=='h')x.fillRect(w/2,0,w/2,h)}
const AB={ajax:'AJX',psv:'PSV',fey:'FEY',rma:'RMA',fcb:'FCB',mun:'MUN',liv:'LFC',bay:'BAY',juv:'JUV',psg:'PSG'};
function drawLogo(x,c){x.fillStyle='#fff';x.beginPath();x.arc(94,34,17,0,7);x.fill();x.lineWidth=5;x.strokeStyle=c.b==c.a?'#222':c.b;x.stroke();x.fillStyle='#111';x.font='900 15px system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText(AB[c.id]||'',94,35,28)}
let KC,KM,KC2,KM2;
function face(o,hair){const mm=(g,c,x,y,z)=>{const q=new T.Mesh(g,c.isMaterial?c:new T.MeshStandardMaterial({color:c,roughness:.8}));q.position.set(x,y,z);o.pv.add(q);return q};const ey=new T.SphereGeometry(.022,6,6);mm(ey,0x111111,-.055,.93,.145);mm(ey,0x111111,.055,.93,.145);mm(new T.BoxGeometry(.05,.01,.01),0x2a1a10,-.055,.97,.15);mm(new T.BoxGeometry(.05,.01,.01),0x2a1a10,.055,.97,.15);mm(new T.BoxGeometry(.022,.04,.02),o.hd.material,0,.9,.158);mm(new T.BoxGeometry(.07,.014,.01),0x8a2f2f,0,.85,.153);if(hair){const h=mm(new T.SphereGeometry(.175,12,8,0,6.3,0,1.15),hair,0,.91,0);h.castShadow=true}}
function dressAll(){const sk=[0xf1c9a5,0xe0ac82,0xc68a5c,0x8d5a3a,0x5a3720],hc=[0x1a1208,0x4a3220,0x8a6a3a,0xd9b84a,0x2a2a2a];face(me);[cr,kp,...df.map(d=>d.o),...pile,...phs.map(p=>p.o),...bjs.map(p=>p.o)].forEach((o,i)=>{o.hd.material=new T.MeshStandardMaterial({color:sk[(i*3)%5],roughness:.7});face(o,hc[(i*2)%5])});
for(const a of[kp.armL,kp.armR]){const g=new T.Mesh(new T.BoxGeometry(.15,.17,.15),new T.MeshStandardMaterial({color:0xffffff}));g.position.y=-.58;a.add(g)}
me.stick=new T.Group();const sh=new T.Mesh(new T.CylinderGeometry(.018,.018,1.15,6),new T.MeshStandardMaterial({color:0x3a2a1a}));sh.position.y=-.45;me.stick.add(sh);const hd=new T.Mesh(new T.BoxGeometry(.04,.1,.3),new T.MeshStandardMaterial({color:0x222222}));hd.position.set(0,-1.02,.1);me.stick.add(hd);me.stick.position.set(0,-.5,.08);me.stick.rotation.x=-.5;me.stick.visible=false;me.armR.add(me.stick);
me.pt=new T.Mesh(new T.CylinderGeometry(.05,.025,.32,8),me.hr);me.pt.position.set(0,.8,-.19);me.pt.rotation.x=.5;me.pt.visible=false;me.pv.add(me.pt)}
function applyClub(){const c=CLUBS.find(x=>x.id==save.club)||CLUBS[0],all=[me,cr,...pile];if(!KC){KC=document.createElement('canvas');KC.width=KC.height=128;KM=new T.MeshStandardMaterial({map:new T.CanvasTexture(KC),roughness:.7});KC2=document.createElement('canvas');KC2.width=KC2.height=128;KM2=new T.MeshStandardMaterial({map:new T.CanvasTexture(KC2),roughness:.7});all.forEach(o=>o.torso.material=[KM2,KM2,KM2,KM2,KM,KM2])}
drawKit(KC.getContext('2d'),128,128,c);drawLogo(KC.getContext('2d'),c);KM.map.needsUpdate=true;drawKit(KC2.getContext('2d'),128,128,c);KM2.map.needsUpdate=true;all.forEach(o=>o.sm.color.set(c.a));[me,cr].forEach(o=>{o.pv.children[2].material.color.set(c.sh);o.legL.children[0].material.color.set(c.so);o.legR.children[0].material.color.set(c.so)});
if(window.fanTex){drawKit(window.fanTex[0].getContext('2d'),64,8,c);window.fanTex[1].needsUpdate=true}}
const st=l=>{const f=(l-1)/199,p=PL.find(x=>x.id==save.sel)||PL[0];return{f,speed:(9+f*5)*(1+p.sp),jump:(6.8+f*3.4)*(1+p.ju),power:(21+f*30)*(1+p.pw),tech:Math.min(1,.45+f*.55+p.te)}};
const TECH=[[1,'Schot'],[3,'Kopbal'],[6,'Volley'],[10,'Omhaal (E)'],[25,'Schaarschot'],[50,'Scorpion kick'],[100,'TOLU RAKET']];
const ACR=[[10,'Omhaal',150],[25,'Schaarschot',200],[50,'Scorpion kick',300],[100,'TOLU RAKET',450]];
const LT={cross:['Voorzetten','scoor uit de voorzet'],head:['Hoge voorzetten','spring en kop de bal (H)'],low:['Lage voorzetten','schiet de lage voorzet direct in'],long:['Afstandsschot','schiet van ver op de bal die naar je toe rolt'],battle:['Strijd in de zestien','verdedigers vechten om de bal'],turbo:['Snelle voorzetten','reageer snel!'],dribble:['Dribbelen','dribbel langs de verdedigers en scoor, laat de bal niet afpakken'],acro:['Acrobatenlevel','alleen goals met een omhaal (E) tellen, dubbele punten'],box:['Dribbel de zestien in','begin op de rand van het zestienmetergebied en dribbel met de pijltjes langs 2 verdedigers, en scoor'],pen:['Penalty','neem de penalty: richt met de muis en schiet'],fk:['Vrije trap','schiet over of langs de muur, mik hoog om de muur te passeren'],keep:['Keepen','jij bent de keeper: klik waar je denkt dat de tegenstander schiet, voordat hij trapt'],team:['Heel elftal uitspelen','dribbel langs 10 verdedigers en scoor']};
const LTC=[];const famX=t=>['cross','low','battle','turbo','long'].includes(t);function ltype(l){if(LTC[l])return LTC[l];return LTC[l]=ltype2(l)}
function ltype2(l){if(l%5==0)return'box';if(l<=3)return['cross','low','pen'][l-1];const pool=['cross','fk','keep','low','pen','dribble','battle','long','team','turbo','acro','fk','pen','keep'],prev=ltype(l-1);let k=(l*13+7)%pool.length,t=pool[k],g=0;while((t==prev||(famX(t)&&famX(prev))||(t=='acro'&&l<10)||(t=='dribble'&&l<16)||(t=='team'&&l<19)||(t=='keep'&&l<6))&&g<30){k=(k+1)%pool.length;t=pool[k];g++}return t}
function ltypeOld(l){if(l>=19&&l%10==9)return'team';if(l<4)return l==3?'pen':'cross';return['fk','cross','low','long','battle','turbo','keep'][l%7]}
let LTYPE='cross';
const acrFor=l=>{let r=null,i=-1;ACR.forEach((a,k)=>{if(l>=a[0]){r=a;i=k}});return[r,i]};
let fl=0,ST=st(save.lvl),run=false,att=0,goals=0,need=2,sess=0,lvlPts=0;

// renderer
const cv=$('c'),rd=new T.WebGLRenderer({canvas:cv,antialias:!MOB,powerPreference:'high-performance'});rd.shadowMap.enabled=true;rd.setPixelRatio(MOB?Math.min(1.25,devicePixelRatio):Math.min(2,devicePixelRatio));
const sc=new T.Scene();sc.background=new T.Color(0x0b1a2b);sc.fog=new T.Fog(0x0b1a2b,90,230);
const cam=new T.PerspectiveCamera(62,1,.1,400);
function rs(){rd.setSize(innerWidth,innerHeight,false);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()}addEventListener('resize',rs);rs();
sc.add(new T.HemisphereLight(0xcfe3ff,0x2a4a2a,.7));
const sun=new T.DirectionalLight(0xffffff,.9);sun.position.set(25,60,30);sun.castShadow=true;sun.shadow.mapSize.set(MOB?1024:2048,MOB?1024:2048);
Object.assign(sun.shadow.camera,{left:-50,right:50,top:75,bottom:-75,near:10,far:150});sc.add(sun);
// pitch
(function(){const c=document.createElement('canvas');c.width=680;c.height=1050;const x=c.getContext('2d'),W=680,H=1050;
for(let i=0;i<15;i++){x.fillStyle=i%2?'#2c8a38':'#35a043';x.fillRect(0,i*70,W,70)}
