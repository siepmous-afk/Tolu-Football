(()=>{const j=$('joy'),k=$('kn');let id=null;const mv=e=>{const r=j.getBoundingClientRect(),dx=e.clientX-(r.left+65),dy=e.clientY-(r.top+65),m=Math.min(1,Math.hypot(dx,dy)/55),a=Math.atan2(dy,dx);joy.x=Math.cos(a)*m;joy.y=Math.sin(a)*m;k.style.transform=`translate(${joy.x*40}px,${joy.y*40}px)`};
